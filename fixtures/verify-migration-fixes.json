      "variations": [
        {"value": "control"},
        {"value": "variant-a"},
        {"value": "variant-b"}
      ],
      "defaults": {"onVariation": 0, "offVariation": 0},
      "tags": ["verify"]
    },
    {
      "key": "verify-json-nested",
      "name": "Verify JSON Nested",
