      "variations": [{"value": "default"}, {"value": "account"}, {"value": "org"}],
      "defaults": {"onVariation": 0, "offVariation": 0},
      "tags": ["verify"]
    },
    {
      "key": "verify-rule-rollout",
      "name": "Verify Rule Rollout",
