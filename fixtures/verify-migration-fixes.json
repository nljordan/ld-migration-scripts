      "variations": [{"value": "control"}, {"value": "test"}, {"value": "holdout"}],
      "defaults": {"onVariation": 0, "offVariation": 0},
      "tags": ["verify"]
    },
    {
      "key": "verify-prerequisite",
      "name": "Verify Prerequisite",
      "description": "Depends on verify-boolean-simple",
      "variations": [{"value": true}, {"value": false}],
      "defaults": {"onVariation": 0, "offVariation": 1},
      "tags": ["verify"]
    },
    {
      "key": "verify-rules-and-targets",
