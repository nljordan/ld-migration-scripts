{
  "description": "Flag fixtures to verify migration branch fixes (Phase 1 env scoping, Phase 2 variation/rule handling)",
  "flags": [
    {
      "key": "verify-boolean-simple",
      "name": "Verify Boolean Simple",
      "description": "Basic boolean - baseline for all envs",
      "variations": [{"value": true}, {"value": false}],
      "defaults": {"onVariation": 0, "offVariation": 1},
      "tags": ["verify"]
    },
    {
      "key": "verify-string-three",
      "name": "Verify String Three",
      "description": "3 variations - rule clamping, addVariation (add 4th on source)",
      "variations": [{"value": "a"}, {"value": "b"}, {"value": "c"}],
      "defaults": {"onVariation": 0, "offVariation": 2},
      "tags": ["verify"]
    },
    {
      "key": "verify-number-multi",
      "name": "Verify Number Multi",
      "description": "Numeric variations",
      "variations": [{"value": 0}, {"value": 1}, {"value": 5}],
      "defaults": {"onVariation": 1, "offVariation": 0},
      "tags": ["verify"]
    },
    {
      "key": "verify-multi-var-rules",
      "name": "Verify Multi Var Rules",
      "description": "5 variations - shrink pre-patch, rule clamping",
      "variations": [
        {"value": "v0"},
        {"value": "v1"},
        {"value": "v2"},
        {"value": "v3"},
        {"value": "v4"}
      ],
      "defaults": {"onVariation": 0, "offVariation": 0},
      "tags": ["verify"]
    },
    {
      "key": "verify-targets-single",
      "name": "Verify Targets Single",
