      "variations": [{"value": 1}, {"value": 2}, {"value": 3}],
      "defaults": {"onVariation": 0, "offVariation": 0},
      "tags": ["verify"]
    },
    {
      "key": "verify-rollout-rule",
      "name": "Verify Rollout Rule",
